# .envrc
#use nix

# Toggle test runner strictness (e.g., HALT_ON_FAIL or RUN_ALL)
export TEST_STRICTNESS="RUN_ALL"

# Direct log dump configurations
export TEST_LOG_DIR="./build/test_logs"

# Allow collaborative developer tags in local logging pipelines
export DEV_ENV_LABEL="Bruce-Pi5"

export QUERY_STRING="ge 1:1,2"

export MODE="asan"
